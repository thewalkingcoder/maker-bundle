{
  "name": "twc/maker-bundle",
  "description": "Wrap maker bundle to introduce context option to change destination template",
  "type": "symfony-bundle",
  "license": "MIT",
  "require": {
    "php": "^8.0",
    "symfony/maker-bundle": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "symfony/security-core": "^7.0",
    "symfony/filesystem": "^7.0",
    "symfony/form": "^7.0",
    "symfony/validator": "^7.0",
    "symfony/orm-pack": "^2.3",
    "symfony/messenger": "^7.0",
    "doctrine/doctrine-fixtures-bundle": "^3.3",
    "symfony/finder": "^7.0",
    "symfony/yaml": "^7.0",
    "symfony/twig-pack": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Twc\\MakerBundle\\": "src",
      "Twc\\MakerBundle\\Tests\\": "tests"

